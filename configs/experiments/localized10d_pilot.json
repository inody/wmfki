  "sweeps": {
    "process_sigma": [0.0, 0.05, 0.075, 0.1, 0.15],
    "particle_number": [100, 200, 350, 500],
    "sampled_pairs": [3000, 5000, 10000, 20000, 30000]
  },
  "estimator": {
    "method": "raw_lasso",
    "alpha_count": 60,
    "alpha_min_ratio": 1e-7,
    "max_iter": 200000,
    "tol": 1e-8,
    "fit_intercept": false,
    "standardize": false,
    "selection": "cyclic",
    "report_nonzero_threshold": 1e-8,
    "selection_metric": "independent_validation_weak_residual_mse",
    "truth_used_for_selection": false,
    "test_error_used_for_selection": false,
    "post_lasso_refit": false,
    "coefficient_thresholding": false
  },
  "evaluation": {
    "scientific_repetitions": 3,
    "profile_radius": [0.5, 3.8],
    "profile_grid_size": 400,
    "latent_drift_time_count": 12,
    "latent_drift_target_count": 64,
    "rollout_particles": 100,
    "rollout_horizon": 5.0,
    "divergence_absolute_position": 1000000.0
  },
  "seeds": {
    "trajectory_start": 7000000,
    "repetition_stride": 101,
    "validation_offset": 1000000,
    "test_offset": 2000000,
    "pair_start": 10000000,
    "pair_validation_offset": 1000000,
    "space_start": 12000000,
    "evaluation_start": 13000000
  },
  "pair_penalty_policy": "absolute_alpha_selected_at_Pmax_by_independent_validation_then_fixed_across_all_P_within_repetition",
  "pilot_acceptance": {
    "maximum_geometric_mean_condition_A": 100000.0,
    "maximum_baseline_lasso_coefficient_error": 0.25,
    "maximum_baseline_lasso_profile_error": 0.25,
    "maximum_baseline_lasso_drift_error": 0.15,
    "maximum_first_repetition_trajectory_error": 0.05,
    "direction_relative_tolerance": 0.15,
    "required_lasso_endpoint_directions": {
      "process_sigma": "increase",
      "particle_number": "decrease",
      "sampled_pairs": "decrease"
