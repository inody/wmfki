{
  "task": "localized10d_matched_pilot",
  "protocol_version": 1,
  "pilot_only": true,
  "model": {
    "dimension": 10,
    "particles": 500,
    "steps": 500,
    "dt": 0.01,
    "observation_stride": 2,
    "trajectories_per_split": 1,
    "sigma": 0.05,
    "initial_law": "normal_scale_mixture",
    "initial_scale": 0.5,
    "initial_scales": [0.25, 0.4, 0.55, 0.7],
    "solver": "euler",
    "interaction": {
      "mode": "gaussian_shell",
      "centers": [1.2, 1.8, 2.4, 3.0],
      "h": 0.2,
      "coefficients": [0.0, 1.5, -1.0, 0.0]
    }
  },
  "dictionary": {
    "basis": "gaussian_shell",
    "M": 4,
    "centers": [1.2, 1.8, 2.4, 3.0],
    "h": 0.2
