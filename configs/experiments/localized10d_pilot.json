    "spatial_type": "gaussian",
    "spatial_count": 25,
    "spatial_scale_factor": 1.5,
    "spatial_layout": "random",
    "spatial_quantiles": [0.01, 0.99],
    "temporal_type": "bump",
    "temporal_count": 8,
    "temporal_support_factor": 1.8,
    "normalize_rows": true
  },
  "pair_sampling": {
    "baseline_pairs": 10000,
    "mode": "nested_resample_each_time",
