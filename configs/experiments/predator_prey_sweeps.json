    "a": 1.0,
    "b": 0.2,
    "c": 0.4,
    "p": 3.0,
    "delta": 0.05,
    "prey_initial_box": [-0.5, 0.5],
    "predator_initial_box": [-0.5, 0.5],
    "solver": "rk4"
  },
  "observation": {
